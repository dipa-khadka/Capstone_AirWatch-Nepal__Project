# Copy this file to .env and fill in your own values. Never push .env to GitHub.
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=airwatch

# Free token from https://aqicn.org/data-platform/token/
WAQI_TOKEN=

# Optional: fetch live data automatically every N minutes while the server runs (0 = off)
AUTO_REFRESH_MINUTES=0

# Optional: port of the website (default 5001)
PORT=5001
